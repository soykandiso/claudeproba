{
	admin off
}

# Local development defaults to :80. In production set CADDY_SITE_ADDRESS to the
# real hostname and Caddy obtains and renews a certificate automatically.
# Cloudflare in front must then be Full (Strict) -- Flexible would downgrade this
# to plaintext on the hop Caddy is securing.
{$CADDY_SITE_ADDRESS::80} {
	encode zstd gzip

	reverse_proxy web:8000 {
		health_uri /healthz
		health_interval 10s
	}

	log {
		output stdout
		format console
	}
}
