# Copy to .env for local development. Never commit .env.
#
# This single file serves two readers: the Flask app (GRANTS_* variables) and
# docker compose. Inside compose, the database and redis URLs are overridden with
# service names, so the values below are what you get when running the app
# directly on the host with `uv run flask run`.

# --- Application ---------------------------------------------------------
GRANTS_ENV=development
GRANTS_DEBUG=true

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GRANTS_SECRET_KEY=dev-only-not-a-secret

# Set from the git SHA at build time so /healthz confirms what is deployed.
GRANTS_VERSION=dev

# Used when running on the host; compose overrides both with service names.
GRANTS_DATABASE_URL=postgresql://grants:grants@localhost:5432/grants
GRANTS_REDIS_URL=redis://localhost:6379/0

# Local embedding model files (flask ingest fetch-model). Compose overrides this.
GRANTS_MODEL_DIR=models

GRANTS_DEFAULT_LANGUAGE=mk
GRANTS_TIMEZONE=Europe/Skopje

# healthchecks.io checks (docs/runbook.md §4). Leave empty in development.
#   INGEST: period 4 hours, grace 3 hours -- pinged by every `flask ingest due`
#   HEALTH: period 1 day, grace 2 hours  -- told by `flask ingest health` whether sources are ok
GRANTS_HEARTBEAT_INGEST_URL=
GRANTS_HEARTBEAT_HEALTH_URL=

# Alarm threshold, not a hard limit (docs/decisions.md D8).
GRANTS_MODEL_SPEND_CEILING_EUR=30

# --- Compose -------------------------------------------------------------
POSTGRES_USER=grants
POSTGRES_DB=grants
# Required. Use a real value in anything deployed.
POSTGRES_PASSWORD=grants
# Host-side port for psql and alembic; bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# ":80" serves plain HTTP locally. In production set this to the real hostname
# and Caddy obtains and renews a certificate automatically.
CADDY_SITE_ADDRESS=:80

# Host ports. Raise these locally if 80/443 are already taken.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Backups ---------------------------------------------------------------
# age PUBLIC key. The server encrypts with this and cannot decrypt; the matching
# private key lives off the server. Generate a pair with:  age-keygen -o key.txt
BACKUP_AGE_RECIPIENT=age1...
# Private key, needed only to RESTORE. Never put this on the production server.
BACKUP_AGE_IDENTITY=/path/to/backup-key.txt
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=6
# rclone target for off-site copies, e.g. hetzner:grants-backups. Unset means
# the backup stays on this machine, which is not a backup.
BACKUP_REMOTE=
# healthchecks.io ping, called only on success.
HEARTBEAT_URL=
