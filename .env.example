# Copy to .env for local development. Never commit .env.
# Every variable is optional; the defaults in app/config.py are development-safe.

GRANTS_ENV=development
GRANTS_DEBUG=true

# Generate for any deployed environment:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GRANTS_SECRET_KEY=dev-only-not-a-secret

# Set from the git SHA at build time so /healthz can confirm what is deployed.
GRANTS_VERSION=dev

# Services arrive in P0.5 session 2 (docker compose).
GRANTS_DATABASE_URL=postgresql+psycopg://grants:grants@localhost:5432/grants
GRANTS_REDIS_URL=redis://localhost:6379/0

GRANTS_DEFAULT_LANGUAGE=mk
GRANTS_TIMEZONE=Europe/Skopje

# Alarm threshold, not a hard limit (docs/decisions.md D8).
GRANTS_MODEL_SPEND_CEILING_EUR=30
