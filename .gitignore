# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local data. `data/` is NOT here: it is versioned reference data — the activity
# classification, the municipalities, the regions — and a reclassification has to
# show up in a diff (CLAUDE.md, data/README.md). Nothing writes to it at runtime.
/snapshots/
/models/
*.sqlite3
*.dump
*.sql.gz

# Backups and keys. A committed backup is a data breach; a committed age private
# key makes every backup readable by anyone who clones the repo.
/backups/
*.age
*key.txt

# Build output
/app/static/dist/
tailwindcss

# Editors / OS
.DS_Store
.idea/
.vscode/

# Development mail (app/mail.py "outbox"): sign-in links, never committed.
var/
